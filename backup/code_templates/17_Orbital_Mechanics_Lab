<!DOCTYPE html><html lang="en"><head>    <meta charset="UTF-8">    <meta name="viewport" content="width=device-width, initial-scale=1.0">    <title>Orbital Mechanics Lab</title>    <style>        body { margin: 0; overflow: hidden; background: #050505; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }        canvas { display: block; }        #ui {            position: absolute;            top: 20px;            left: 20px;            color: white;            background: rgba(0, 0, 0, 0.7);            padding: 20px;            border-radius: 12px;            border: 1px solid rgba(255, 255, 255, 0.2);            pointer-events: none;            user-select: none;            backdrop-filter: blur(5px);        }        h1 { margin: 0 0 10px 0; font-size: 18px; text-transform: uppercase; letter-spacing: 2px; color: {{ui_accent_color}}; }        p { margin: 5px 0; font-size: 14px; opacity: 0.8; }        .controls { margin-top: 15px; font-weight: bold; color: #00d4ff; }    </style></head><body>    <div id="ui">        <h1>Gravity Lab</h1>        <p>Simulation of N-Body Physics</p>        <p class="controls">Click & Drag to launch asteroids</p>        <p>Right Click to rotate view</p>    </div>    <script type="module">        import * as THREE from 'https://cdn.skypack.dev/three@0.136.0';        import { OrbitControls } from 'https://cdn.skypack.dev/three@0.136.0/examples/jsm/controls/OrbitControls.js';        /* --- Configuration Injection Inits --- */        const G = parseFloat("{{g_constant}}") || 0.5;        const SUN_MASS = parseFloat("{{sun_mass}}") || 1000;        const PLANET_MASS = parseFloat("{{planet_mass}}") || 10;        const ASTEROID_MASS = parseFloat("{{asteroid_mass}}") || 0.5;        const LAUNCH_SCALE = parseFloat("{{launch_velocity_scale}}") || 0.05;        const NUMBER_STARS = parseInt("{{number_stars}}", 10) || 1;        const NUMBER_PLANETS = parseInt("{{number_planets}}", 10) || 1;        const LAUNCH_ASTEROID = "{{launch_asteroid}}" === "true";        const TRAIL_LENGTH = parseInt("{{trail_length}}", 10) || 200;        const SINGULARITY_THRESHOLD = parseFloat("{{singularity_threshold}}") || 5.0;        const PLANET_DIST = parseFloat("{{planet_distance}}") || 150;        const STAR_COUNT = parseInt("{{star_count}}", 10) || 5000;        const STAR_SPREAD = parseFloat("{{star_spread}}") || 2000;        const bodies = [];        /* --- Scene Setup --- */        const scene = new THREE.Scene();        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 5000);        camera.position.set(0, 150, 300);        const renderer = new THREE.WebGLRenderer({ antialias: true });        renderer.setSize(window.innerWidth, window.innerHeight);        renderer.setPixelRatio(window.devicePixelRatio);        document.body.appendChild(renderer.domElement);        const controls = new OrbitControls(camera, renderer.domElement);        controls.enableDamping = true;        /* --- Lighting --- */        const ambientLight = new THREE.AmbientLight(0x404040, 1);        scene.add(ambientLight);        const sunLight = new THREE.PointLight(0xffffff, 2, 1000);        scene.add(sunLight);        /* --- Background Stars --- */        const starGeometry = new THREE.BufferGeometry();        const starMaterial = new THREE.PointsMaterial({ color: 0xffffff });        const starVertices = [];        for (let i = 0; i < STAR_COUNT; i++) {            starVertices.push(                THREE.MathUtils.randFloatSpread(STAR_SPREAD),                THREE.MathUtils.randFloatSpread(STAR_SPREAD),                THREE.MathUtils.randFloatSpread(STAR_SPREAD)            );        }        starGeometry.setAttribute('position', new THREE.Float32BufferAttribute(starVertices, 3));        const stars = new THREE.Points(starGeometry, starMaterial);        scene.add(stars);        /* --- Celestial Objects Generator --- */        function createBody(radius, color, mass, pos, vel, isSun = false) {            const geometry = new THREE.SphereGeometry(radius, 32, 32);            let material;            if (isSun) {                material = new THREE.MeshBasicMaterial({                     color: 0xffdd44,                    transparent: true,                    opacity: 1.0                });            } else {                material = new THREE.MeshStandardMaterial({ color: color, roughness: 0.7 });            }                        const mesh = new THREE.Mesh(geometry, material);            mesh.position.copy(pos);            scene.add(mesh);            if (isSun) {                /* Layer 1: Dense, bright inner thermal glow envelope */                const innerGlowGeo = new THREE.SphereGeometry(radius * 1.2, 32, 32);                const innerGlowMat = new THREE.MeshBasicMaterial({                     color: 0xffaa00,                     transparent: true,                     opacity: 0.4,                     side: THREE.BackSide,                    blending: THREE.AdditiveBlending                });                const innerGlow = new THREE.Mesh(innerGlowGeo, innerGlowMat);                mesh.add(innerGlow);                /* Layer 2: Massive, soft wide-field high-intensity corona atmosphere */                const outerGlowGeo = new THREE.SphereGeometry(radius * 2.2, 32, 32);                const outerGlowMat = new THREE.MeshBasicMaterial({                     color: 0xff4400,                     transparent: true,                     opacity: 0.18,                     side: THREE.BackSide,                    blending: THREE.AdditiveBlending                });                const outerGlow = new THREE.Mesh(outerGlowGeo, outerGlowMat);                mesh.add(outerGlow);            }            const body = {                mesh,                mass,                velocity: vel,                acceleration: new THREE.Vector3(0, 0, 0),                isSun,                path: [],                trail: null            };                        if(!isSun) {                const trailMat = new THREE.LineBasicMaterial({ color: color, transparent: true, opacity: 0.4 });                const trailGeo = new THREE.BufferGeometry();                body.trail = new THREE.Line(trailGeo, trailMat);                scene.add(body.trail);            }            bodies.push(body);            return body;        }        /* Initialize N-Stars in a balanced central configuration */        const totalStarMass = SUN_MASS * NUMBER_STARS;        for (let s = 0; s < NUMBER_STARS; s++) {            let position = new THREE.Vector3(0, 0, 0);            let velocity = new THREE.Vector3(0, 0, 0);                        /* If binary or multi-star, offset them symmetrically and apply counter-balancing velocities */            if (NUMBER_STARS > 1) {                const angle = (s / NUMBER_STARS) * Math.PI * 2;                const orbitRadius = 25;                position.set(Math.cos(angle) * orbitRadius, 0, Math.sin(angle) * orbitRadius);                                const vStar = Math.sqrt((G * SUN_MASS) / (orbitRadius * 2));                velocity.set(-Math.sin(angle) * vStar, 0, Math.cos(angle) * vStar);            }                        createBody(20 - (NUMBER_STARS * 2), 0xffaa00, SUN_MASS, position, velocity, true);        }        /* Initialize N-Planets staggered across unique orbital plane paths */        const planetColors = [0x00aaff, 0x00ffaa, 0xff5500, 0xaa00ff, 0xff00aa, 0xccff00];        for (let p = 0; p < NUMBER_PLANETS; p++) {            /* Increment radius per planet so orbits do not spawn on top of each other */            const currentDist = PLANET_DIST + (p * 45);            const vMag = Math.sqrt((G * totalStarMass) / currentDist);                        /* Randomize starting orbital angle to make the layout look natural */            const startAngle = Math.random() * Math.PI * 2;            const pPos = new THREE.Vector3(Math.cos(startAngle) * currentDist, 0, Math.sin(startAngle) * currentDist);            const pVel = new THREE.Vector3(-Math.sin(startAngle) * vMag, 0, Math.cos(startAngle) * vMag);                        const colorIdx = p % planetColors.length;            createBody(6 - (p * 0.3), planetColors[colorIdx], PLANET_MASS, pPos, pVel, false);        }        /* --- Vector Interaction Raycasting Pipeline --- */        let isMouseDown = false;        let startPoint = new THREE.Vector3();        const launchLineGeom = new THREE.BufferGeometry();        const launchLineMat = new THREE.LineBasicMaterial({ color: 0xff0000 });        const launchLine = new THREE.Line(launchLineGeom, launchLineMat);        scene.add(launchLine);        const mouse = new THREE.Vector2();        const raycaster = new THREE.Raycaster();        const plane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);        window.addEventListener('mousedown', (e) => {            if (!LAUNCH_ASTEROID) return;            if (e.button !== 0) return;            isMouseDown = true;            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;            raycaster.setFromCamera(mouse, camera);            raycaster.ray.intersectPlane(plane, startPoint);        });        window.addEventListener('mousemove', (e) => {            if (!LAUNCH_ASTEROID) return;            if (!isMouseDown) return;            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;            raycaster.setFromCamera(mouse, camera);            const currentPoint = new THREE.Vector3();            raycaster.ray.intersectPlane(plane, currentPoint);                        launchLine.geometry.setFromPoints([startPoint, currentPoint]);        });        window.addEventListener('mouseup', (e) => {            if (!LAUNCH_ASTEROID) return;            if (e.button !== 0 || !isMouseDown) return;            isMouseDown = false;            const endPoint = new THREE.Vector3();            raycaster.ray.intersectPlane(plane, endPoint);                        /* Interactive kinetic injection magnitude calculation */            const vel = startPoint.clone().sub(endPoint).multiplyScalar(LAUNCH_SCALE);            createBody(2.5, 0xaaaaaa, ASTEROID_MASS, startPoint.clone(), vel);                        launchLine.geometry.setFromPoints([]);        });        /* --- N-Body Vector Gravity Physics Solver Engine --- */        function updatePhysics() {            const bodiesToRemove = new Set();            for (let i = 0; i < bodies.length; i++) {                const b1 = bodies[i];                b1.acceleration.set(0, 0, 0);                for (let j = 0; j < bodies.length; j++) {                    if (i === j) continue;                    const b2 = bodies[j];                                                            const diff = new THREE.Vector3().subVectors(b2.mesh.position, b1.mesh.position);                    const distSq = diff.lengthSq();                    const dist = Math.sqrt(distSq);                    if (dist < SINGULARITY_THRESHOLD) continue;                     /* Collision Boundary Check: If small objects drift into core corona coordinates, target them for removal */                    if (b2.isSun && !b1.isSun && dist < 18) {                        bodiesToRemove.add(i);                        continue;                    }                    const forceMag = (G * b1.mass * b2.mass) / distSq;                    const force = diff.normalize().multiplyScalar(forceMag);                    b1.acceleration.add(force.divideScalar(b1.mass));                }            }            /* Safe structural array extraction processing loop */            if (bodiesToRemove.size > 0) {                for (let i = bodies.length - 1; i >= 0; i--) {                    if (bodiesToRemove.has(i)) {                        const b = bodies[i];                        scene.remove(b.mesh);                        if (b.trail) scene.remove(b.trail);                        bodies.splice(i, 1);                    }                }            }            for (const b of bodies) {                b.velocity.add(b.acceleration);                b.mesh.position.add(b.velocity);                /* Render Dynamic Spatial History Trails */                if (!b.isSun) {                    b.path.push(b.mesh.position.clone());                    if (b.path.length > TRAIL_LENGTH) b.path.shift();                    b.trail.geometry.setFromPoints(b.path);                }            }        }        function animate() {            requestAnimationFrame(animate);            updatePhysics();            controls.update();            renderer.render(scene, camera);        }        window.addEventListener('resize', () => {            camera.aspect = window.innerWidth / window.innerHeight;            camera.updateProjectionMatrix();            renderer.setSize(window.innerWidth, window.innerHeight);        });        animate();    </script></body></html>
